# =============================================================================
# Algorand Sovereignty Analyzer - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# SECURITY: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC API (Required for AI Coaching Feature)
# -----------------------------------------------------------------------------
# Get your API key at: https://console.anthropic.com/
# The coaching feature will be disabled if this is not set.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# ALGORAND NODE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# By default, the app uses the public AlgoNode API (free, no auth needed).
# Set these if you want to use your own Algorand node.

# URL for your Algorand node (default: https://mainnet-api.algonode.cloud)
# ALGORAND_NODE_URL=http://127.0.0.1:8080

# Authentication token for your private node (leave empty for AlgoNode)
# ALGORAND_NODE_TOKEN=

# -----------------------------------------------------------------------------
# CORS CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# Default is "*" which allows all origins (suitable for development).
# For production, specify your frontend domain(s).
# Example: CORS_ORIGINS=https://myapp.com,https://www.myapp.com
# CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# DATABASE RESEED FLAGS (Optional)
# -----------------------------------------------------------------------------
# Set to 'true' to reseed miner metrics databases on startup.
# Useful for initial setup or data refresh.
# RESEED_MINERS=false
# RESEED_SILVER=false
